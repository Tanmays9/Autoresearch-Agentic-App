# Brave is the only external API credential. Research still works through
# authenticated CLI agents when this is left empty.
BRAVE_SEARCH_API_KEY=

API_PORT=8000
WEB_PORT=3000
DATABASE_URL=sqlite:////app/data/research.db
LOCAL_TOKEN_FILE=/app/.local/token
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Local CPU embeddings are optional and lazily downloaded on first use.
ENABLE_EMBEDDINGS=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Azure supplies inference only; LangGraph agents and tools run locally.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_RESEARCH_DEPLOYMENT=gpt-5.6-sol
AZURE_REASONING_DEPLOYMENT=gpt-5.6-sol
INHOUSE_AGENT_CONCURRENCY=5
AZURE_TOKEN_BUDGET=1000000
AZURE_COST_BUDGET_USD=50
# Configurable local cost estimates used only for budget enforcement/reporting.
AZURE_RESEARCH_COST_PER_MILLION_TOKENS=10
AZURE_REASONING_COST_PER_MILLION_TOKENS=10
